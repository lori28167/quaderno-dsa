{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quaderno DSA",
  "version": "0.1.0",
  "identifier": "it.quadernodsa.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quaderno DSA",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Lorenzo Cozzaglio",
    "copyright": "© 2026 Lorenzo Cozzaglio — GPLv3 con Commons Clause",
    "category": "Education",
    "shortDescription": "Quaderno digitale accessibile per studenti DSA",
    "longDescription": "Quaderno digitale per studenti DSA delle scuole superiori: testo, calcolo in colonna, grafici e sintesi vocale.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian"]
      },
      "wix": {
        "language": "it-IT"
      }
    }
  }
}
